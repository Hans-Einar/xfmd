find_package(Python3 REQUIRED COMPONENTS Interpreter)
function(xfmd_test name source)
  add_executable(${name} ${source})
  target_link_libraries(${name} PRIVATE xfmd_contracts ${ARGN})
  target_include_directories(${name} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/tests")
  add_test(NAME ${name} COMMAND ${name})
  if(XFMD_SANITIZERS)
    set_tests_properties(${name} PROPERTIES ENVIRONMENT "LSAN_OPTIONS=suppressions=${CMAKE_CURRENT_SOURCE_DIR}/tests/support/lsan.supp;ASAN_OPTIONS=detect_leaks=1:halt_on_error=1;UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1")
  endif()
endfunction()
