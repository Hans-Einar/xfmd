+//! XFMD seam: per-call premeasured labels, restored even during unwinding.
+use std::{cell::RefCell, collections::HashMap};
+use super::{TextBlock, Layout, compute_layout};
+use crate::{ir::Graph, Theme, LayoutConfig};
+thread_local! { static LABELS: RefCell<Option<HashMap<String, TextBlock>>> = const { RefCell::new(None) }; }
+pub fn lookup(text: &str) -> Option<TextBlock> {
+ LABELS.with(|slot| slot.borrow().as_ref().map(|labels| labels.get(text).unwrap_or_else(|| panic!("Missing measured label: {text}")).clone()))
+}
+pub fn layout(graph: &Graph, theme: &Theme, config: &LayoutConfig, labels: HashMap<String, TextBlock>) -> Layout {
+ struct Restore(Option<HashMap<String, TextBlock>>);
+ impl Drop for Restore { fn drop(&mut self) { LABELS.with(|slot| *slot.borrow_mut()=self.0.take()); } }
+ let _restore=Restore(LABELS.with(|slot| slot.replace(Some(labels))));
+ compute_layout(graph, theme, config)
+}
