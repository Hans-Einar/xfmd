#!/usr/bin/python3
"""Forced SSH command: receive only a bounded, flat RPM release batch."""
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path

BASE = Path('/var/lib/xfmd-publish/incoming')
MAX_FILE = 2 * 1024**3
MAX_TOTAL = MAX_FILE

def main():
    command = os.environ.get('SSH_ORIGINAL_COMMAND', '')
    match = re.fullmatch(r'publish (development|stable)', command)
    if not match:
        raise ValueError('Only publish development or publish stable is allowed')
    stage = Path(tempfile.mkdtemp(prefix='batch-', dir=BASE))
    try:
        total = 0
        names = set()
        with tarfile.open(fileobj=sys.stdin.buffer, mode='r|') as archive:
            for member in archive:
                if (not member.isfile() or not re.fullmatch(r'xfmd-[A-Za-z0-9._+^~-]+\.x86_64\.rpm', member.name)
                        or member.name in names or len(names) >= 1
                        or not 0 < member.size <= MAX_FILE):
                    raise ValueError('Invalid RPM archive member')
                total += member.size
                if total > MAX_TOTAL:
                    raise ValueError('Upload is too large')
                names.add(member.name)
                with archive.extractfile(member) as source, (stage / member.name).open('xb') as target:
                    shutil.copyfileobj(source, target, length=1024*1024)
                if (stage / member.name).stat().st_size != member.size:
                    raise ValueError('Truncated RPM')
        if len(names) != 1:
            raise ValueError('Expected exactly one XFMD RPM')
        subprocess.run(['/usr/bin/sudo', '-n', '/usr/local/sbin/xfmd-promote', match[1], stage.name], check=True,
                       env={'PATH': '/usr/bin:/bin', 'LANG': 'C'})
    finally:
        shutil.rmtree(stage)

if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, tarfile.TarError, subprocess.CalledProcessError) as exc:
        print('Publication rejected: ' + str(exc), file=sys.stderr)
        sys.exit(1)
