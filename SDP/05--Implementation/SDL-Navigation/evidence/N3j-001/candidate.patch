diff --git a/SDL/go/viewpoint/feature_overview.go b/SDL/go/viewpoint/feature_overview.go
new file mode 100644
index 0000000..d829751
--- /dev/null
+++ b/SDL/go/viewpoint/feature_overview.go
@@ -0,0 +1,155 @@
+package viewpoint
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+)
+
+// featureOverview keeps complete logical decomposition and only the requested
+// mode's explicit allocation. The empty mode is logical, never a union of modes.
+func (v *Views) featureOverview(q Query) (*Views, error) {
+	out := *v
+	out.Diagrams = []Diagram{}
+	out.MessageSets = []Fact{}
+	out.Facts = []Fact{}
+	out.Relations = map[string][]Fact{}
+	out.Gaps = filter(v.Gaps, func(f Fact) bool { return f.S("viewpoint") == "VP07" && f.S("code") != "UNSPECIFIED_ALLOCATION" })
+	contributions := filter(v.Relations["contributes-to"], func(f Fact) bool { return v.Kinds[f.S("object")] == "feature" })
+	functions := values(contributions, "subject")
+	names := append(append(append(append(v.names("system"), v.names("container")...), v.names("unit")...), v.names("feature")...), functions...)
+	for _, f := range v.Facts {
+		a, b, verb := f.S("subject"), f.S("object"), f.S("verb")
+		keep := verb == "contains" && has(names, a) && has(names, b)
+		keep = keep || verb == "owns" && has(functions, b)
+		keep = keep || verb == "contributes-to" && v.Kinds[b] == "feature"
+		keep = keep || verb == "allocated-to" && q.Mode != "" && f.S("mode") == q.Mode && has(functions, a)
+		if keep {
+			out.Facts = append(out.Facts, f)
+			out.Relations[verb] = append(out.Relations[verb], f)
+		}
+	}
+	if q.Mode != "" {
+		for _, f := range contributions {
+			if len(eq(out.Relations["allocated-to"], "subject", f.S("subject"))) == 0 {
+				out.goalGap("VP07", f.S("subject"), "UNSPECIFIED_ALLOCATION", "Container allocation is unspecified for contributions to "+f.S("object")+".", q.Mode, f.S("object"))
+			}
+		}
+	}
+	title := "Complete logical architecture and feature realization"
+	if q.Mode != "" {
+		title += " — mode " + q.Mode
+	}
+	// The complete structural base stays readable: feature keys annotate actual
+	// owners/allocations; function paths and their proof remain in the companion table.
+	structural := append(append(v.names("system"), v.names("container")...), v.names("unit")...)
+	features := v.names("feature")
+	elements := []Fact{}
+	for i, feature := range features {
+		placed := false
+		for _, c := range eq(out.Relations["contributes-to"], "object", feature) {
+			for _, role := range []string{"owns", "allocated-to"} {
+				for _, f := range out.Relations[role] {
+					endpoint := f.S("subject")
+					matches := role == "owns" && f.S("object") == c.S("subject")
+					if role == "allocated-to" {
+						matches = f.S("subject") == c.S("subject")
+						endpoint = f.S("object")
+					}
+					if matches {
+						placed = true
+						elements = append(elements, Fact{"feature": feature, "key": fmt.Sprintf("F%02d", i+1), "node": "n_" + endpoint, "role": role, "source_facts": []string{c.S("id"), f.S("id")}})
+					}
+				}
+			}
+		}
+		if !placed {
+			structural = append(structural, feature)
+		}
+	}
+	out.diagram("VP07-overview", title, out.Relations["contains"], structural...)
+	if len(out.Diagrams) == 0 {
+		return &out, nil
+	}
+	d := &out.Diagrams[0]
+	d.Elements = elements
+	d.SourceFacts = values(out.Facts, "id")
+	if len(d.Nodes) > 128 || len(d.Edges) > 320 {
+		return nil, fmt.Errorf("overview-limit: complete VP07 exceeds flowchart profile; no partial overview generated")
+	}
+	d.Syntax = featureSyntax(*d)
+	return &out, nil
+}
+
+func featureSyntax(d Diagram) string {
+	var b strings.Builder
+	b.WriteString("flowchart LR\n")
+	ids := []string{}
+	for id := range d.Nodes {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	for _, id := range ids {
+		data := d.Nodes[id].(map[string]any)
+		label := fmt.Sprintf("%s (%s)", data["model_id"], data["kind"])
+		for _, role := range []string{"owns", "allocated-to"} {
+			keys := []string{}
+			for _, e := range d.Elements {
+				if e.S("node") == id && e.S("role") == role {
+					keys = append(keys, e.S("key"))
+				}
+			}
+			if len(keys) > 0 {
+				label += " | " + role + ": " + strings.Join(unique(keys), " ")
+			}
+		}
+		switch data["kind"] {
+		case "feature":
+			fmt.Fprintf(&b, "    %s(\"%s\")\n", id, label)
+		default:
+			fmt.Fprintf(&b, "    %s[\"%s\"]\n", id, label)
+		}
+	}
+	for _, e := range d.Edges {
+		fmt.Fprintf(&b, "    %s -->|%s| %s\n", e.Source, e.Relation, e.Target)
+	}
+	return b.String()
+}
+
+func (v *Views) FeatureOverviewContext(mode string) string {
+	var b strings.Builder
+	b.WriteString("## Scope and notation\n\nAll declared Systems, containers and units form the logical architecture base, including isolated declarations. Rectangles show the complete structural base with contains edges. Feature keys annotate logical owners (owns) and selected-mode containers (allocated-to), derived only through explicit Functionality contribution paths. Rounded standalone Features have no represented placement. These annotations are not new direct SDL relations. This is decomposition and responsibility, not an inferred deployment or call graph.\n\n")
+	if mode == "" {
+		b.WriteString("Logical scope: allocation annotations are intentionally absent. Select a named mode under VP07 in the navigation tree to inspect its explicit placement. No allocations from different modes are combined.\n\n")
+	} else {
+		fmt.Fprintf(&b, "Selected mode: **%s**. Only this mode's explicit allocated-to facts inform placement annotations. Ownership does not imply allocation; missing placement is reported below.\n\n", mode)
+	}
+	b.WriteString("## Feature legend\n\n| Key | Feature |\n| --- | --- |\n")
+	for i, f := range v.names("feature") {
+		fmt.Fprintf(&b, "| F%02d | %s |\n", i+1, f)
+	}
+	b.WriteString("\n")
+	b.WriteString("## Feature contributions\n\n| Feature | Functionality | Logical owner | Allocation in selected scope | Source facts |\n| --- | --- | --- | --- | --- |\n")
+	for _, feature := range v.names("feature") {
+		cs := eq(v.Relations["contributes-to"], "object", feature)
+		if len(cs) == 0 {
+			fmt.Fprintf(&b, "| %s | Not specified | — | — | — |\n", feature)
+		}
+		for _, c := range cs {
+			fn := c.S("subject")
+			owners := strings.Join(values(eq(v.Relations["owns"], "object", fn), "subject"), ", ")
+			placed := "Not selected (logical scope)"
+			if mode != "" {
+				placed = strings.Join(values(eq(v.Relations["allocated-to"], "subject", fn), "object"), ", ")
+				if placed == "" {
+					placed = "Unspecified"
+				}
+			}
+			proof := []string{c.S("id")}
+			proof = append(proof, values(eq(v.Relations["owns"], "object", fn), "id")...)
+			proof = append(proof, values(eq(v.Relations["allocated-to"], "subject", fn), "id")...)
+			fmt.Fprintf(&b, "| %s | %s | %s | %s | %s |\n", feature, fn, owners, placed, strings.Join(proof, ", "))
+		}
+	}
+	return b.String() + "\n"
+}
diff --git a/SDL/go/viewpoint/feature_overview_test.go b/SDL/go/viewpoint/feature_overview_test.go
new file mode 100644
index 0000000..995f132
--- /dev/null
+++ b/SDL/go/viewpoint/feature_overview_test.go
@@ -0,0 +1,134 @@
+package viewpoint
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestVP07OverviewArchitectureAndModeIsolation(t *testing.T) {
+	source := `language design-core version 0.5.
+unit Root.
+unit Owner.
+unit Unrelated.
+container Local.
+container Remote.
+functionality Work.
+functionality Missing.
+feature Feature.
+feature Isolated.
+mode Online.
+mode Offline.
+Root contains Owner.
+Owner owns Work.
+Owner owns Missing.
+Work contributes-to Feature.
+Missing contributes-to Feature.
+Work allocated-to Local in mode Offline.
+Work allocated-to Remote in mode Online.
+`
+	v, e := New(canonicalOverview(t, source))
+	if e != nil {
+		t.Fatal(e)
+	}
+	for _, mode := range []string{"", "Offline", "Online"} {
+		s, e := v.Select(Query{Viewpoint: "VP07", Projection: "overview", Mode: mode})
+		if e != nil {
+			t.Fatal(e)
+		}
+		if len(s.Diagrams) != 1 || len(s.Diagrams[0].Nodes) != 6 {
+			t.Fatalf("incomplete architecture: %#v", s.Diagrams)
+		}
+		d := s.Diagrams[0]
+		syntax := d.Mermaid()
+		for _, part := range []string{"Unrelated", "Isolated", "n_Isolated(\"", "owns: F01", "-->|contains|"} {
+			if !strings.Contains(syntax, part) {
+				t.Fatal(part, syntax)
+			}
+		}
+		alloc := s.Relations["allocated-to"]
+		if mode == "" {
+			if len(alloc) != 0 || strings.Contains(syntax, "allocated-to") {
+				t.Fatal("logical view mixed allocations")
+			}
+		} else {
+			if len(alloc) != 1 || alloc[0].S("mode") != mode {
+				t.Fatal("cross-mode allocation", alloc)
+			}
+			found := false
+			for _, g := range s.Gaps {
+				if g.S("code") == "UNSPECIFIED_ALLOCATION" {
+					if g.S("model_id") != "Missing" || g.S("mode") != mode {
+						t.Fatal(g)
+					}
+					found = true
+				}
+			}
+			if !found {
+				t.Fatal("missing unallocated contribution gap")
+			}
+		}
+		for _, annotation := range d.Elements {
+			if annotation.S("role") == "allocated-to" {
+				expected := "n_Local"
+				if mode == "Online" {
+					expected = "n_Remote"
+				}
+				if mode == "" || annotation.S("node") != expected {
+					t.Fatal("cross-mode annotation", annotation)
+				}
+			}
+		}
+		proof := map[string]bool{}
+		for _, f := range s.Facts {
+			proof[f.S("id")] = true
+		}
+		for _, annotation := range d.Elements {
+			for _, id := range annotation["source_facts"].([]string) {
+				if !proof[id] {
+					t.Fatal("unproven annotation", annotation)
+				}
+			}
+		}
+		for _, edge := range d.Edges {
+			if !proof[edge.Fact] {
+				t.Fatal("invented edge", edge)
+			}
+		}
+		if !strings.Contains(s.FeatureOverviewContext(mode), "Isolated | Not specified") {
+			t.Fatal("isolated feature lost")
+		}
+	}
+	if _, e = v.Select(Query{Viewpoint: "VP07", Projection: "overview", Mode: "NoSuchMode"}); e == nil {
+		t.Fatal("unknown mode accepted")
+	}
+	if _, e = v.Select(Query{Viewpoint: "VP01", Projection: "overview", Mode: "Online"}); e == nil {
+		t.Fatal("VP01 mode ignored")
+	}
+	for _, d := range v.Diagrams {
+		if d.ID == "VP07-overview" {
+			t.Fatal("overview generated eagerly")
+		}
+	}
+}
+
+func TestVP07OverviewEmptyAndNoModes(t *testing.T) {
+	for _, source := range []string{"language design-core version 0.5.\nactor Alone.\n", "language design-core version 0.5.\nfeature Alone.\n"} {
+		v, e := New(source)
+		if e != nil {
+			t.Fatal(e)
+		}
+		s, e := v.Select(Query{Viewpoint: "VP07", Projection: "overview"})
+		if e != nil {
+			t.Fatal(e)
+		}
+		if len(s.Gaps) == 0 {
+			t.Fatal("missing truthful empty-model gap")
+		}
+		if v.Kinds["Alone"] == "actor" && len(s.Diagrams) != 0 {
+			t.Fatal("invented architecture")
+		}
+		if v.Kinds["Alone"] == "feature" && (len(s.Diagrams) != 1 || len(s.Diagrams[0].Nodes) != 1) {
+			t.Fatal("isolated feature omitted")
+		}
+	}
+}
diff --git a/SDL/go/viewpoint/overview.go b/SDL/go/viewpoint/overview.go
new file mode 100644
index 0000000..fa42b8a
--- /dev/null
+++ b/SDL/go/viewpoint/overview.go
@@ -0,0 +1,80 @@
+package viewpoint
+
+import (
+	"fmt"
+	"strings"
+)
+
+// HasOverview advertises implemented projections only. It never generates output.
+func HasOverview(vp string) bool { return vp == "VP01" || vp == "VP07" }
+
+// overview selects the complete validated inventory, not a union of detail views.
+func (v *Views) overview(q Query) (*Views, error) {
+	if q.Viewpoint == "VP07" {
+		return v.featureOverview(q)
+	}
+	out := *v
+	out.Diagrams = []Diagram{}
+	out.MessageSets = []Fact{}
+	out.Facts = filter(v.Facts, func(f Fact) bool { return has([]string{"pursues", "supports", "contributes-to"}, f.S("verb")) })
+	out.Relations = map[string][]Fact{}
+	for _, f := range out.Facts {
+		out.Relations[f.S("verb")] = append(out.Relations[f.S("verb")], f)
+	}
+	out.Gaps = filter(v.Gaps, func(f Fact) bool { return f.S("viewpoint") == q.Viewpoint })
+	names := append(v.names("actor"), v.names("usecase")...)
+	if len(names) == 0 {
+		return &out, nil
+	}
+	// Match the documented native profile's total record/identity boundaries.
+	// Reject the whole projection rather than silently omitting declarations.
+	if len(names) > 128 || len(names)+len(v.Relations["pursues"])+1 > 512 {
+		return nil, fmt.Errorf("overview-limit: complete VP01 exceeds native profile; no partial overview generated")
+	}
+	d := Diagram{ID: "VP01-overview", Title: "All declared actors and use cases", Kind: "usecase", Nodes: map[string]any{}, Edges: []Edge{}, SourceFacts: []string{}, Elements: []Fact{}}
+	ids := map[string]string{}
+	sourceNodes := v.nodes(names)
+	var syntax strings.Builder
+	syntax.WriteString("usecase-beta\ndirection LR\n")
+	for i, name := range names {
+		id := fmt.Sprintf("u%d", i)
+		ids[name] = id
+		d.Nodes[id] = sourceNodes["n_"+name]
+		if v.Kinds[name] == "actor" {
+			syntax.WriteString("actor ")
+		}
+		fmt.Fprintf(&syntax, "%s(\"%s\")\n", id, name)
+	}
+	for _, f := range v.Relations["pursues"] {
+		a, b := ids[f.S("subject")], ids[f.S("object")]
+		if a == "" || b == "" {
+			return nil, fmt.Errorf("invalid checked pursues endpoints")
+		}
+		fmt.Fprintf(&syntax, "%s -- %s\n", a, b)
+		d.Edges = append(d.Edges, Edge{a, "pursues", b, f.S("id")})
+		d.SourceFacts = append(d.SourceFacts, f.S("id"))
+	}
+	d.Syntax = syntax.String()
+	out.Diagrams = append(out.Diagrams, d)
+	return &out, nil
+}
+
+// OverviewContext keeps realization separate from use-case notation. Fact IDs
+// and the bundle's full declaration/source registry preserve traceability.
+func (v *Views) OverviewContext() string {
+	var b strings.Builder
+	b.WriteString("## Scope and notation\n\nComplete declared actor/use-case inventory in this source snapshot, including isolated declarations. An association means SDL pursues; no System boundary or UML include/extend is inferred.\n\n")
+	b.WriteString("## Functionality realization\n\nFeatures and Functionality are not use cases. Only modeled supports and contributes-to relations are listed.\n\n| Source | Relation | Target | Fact |\n| --- | --- | --- | --- |\n")
+	count := 0
+	for _, f := range v.Facts {
+		if has([]string{"supports", "contributes-to"}, f.S("verb")) {
+			fmt.Fprintf(&b, "| %s | %s | %s | %s |\n", f.S("subject"), f.S("verb"), f.S("object"), f.S("id"))
+			count++
+		}
+	}
+	if count == 0 {
+		b.WriteString("\nNo functionality realization relations are specified.\n")
+	}
+	b.WriteString("\nScenario sequences and pre/postconditions are not part of this overview; they are not inferred from static relations.\n\n")
+	return b.String()
+}
diff --git a/SDL/go/viewpoint/overview_test.go b/SDL/go/viewpoint/overview_test.go
new file mode 100644
index 0000000..e146f8c
--- /dev/null
+++ b/SDL/go/viewpoint/overview_test.go
@@ -0,0 +1,104 @@
+package viewpoint
+
+import (
+	"fmt"
+	"github.com/Hans-Einar/SDP/SystemDesignLanguage/go/parser"
+	"strings"
+	"testing"
+)
+
+func TestVP01OverviewCompleteAndSeparate(t *testing.T) {
+	source := "language design-core version 0.5.\nactor User.\nactor IsolatedActor.\nfeature Feature.\nfunctionality Function.\nunit Owner.\n"
+	for i := 0; i < 30; i++ {
+		source += fmt.Sprintf("usecase Goal%d.\n", i)
+	}
+	source += "Owner owns Function.\nUser pursues Goal0.\nFeature supports Goal0.\nFunction contributes-to Feature.\n"
+	v, e := New(canonicalOverview(t, source))
+	if e != nil {
+		t.Fatal(e)
+	}
+	s, e := v.Select(Query{Viewpoint: "VP01", Projection: "overview"})
+	if e != nil {
+		t.Fatal(e)
+	}
+	if len(s.Diagrams) != 1 || len(s.Diagrams[0].Nodes) != 32 || len(s.Diagrams[0].Edges) != 1 {
+		t.Fatalf("incomplete: %#v", s.Diagrams)
+	}
+	seen := map[string]bool{}
+	for _, data := range s.Diagrams[0].Nodes {
+		seen[data.(map[string]any)["model_id"].(string)] = true
+	}
+	for name, kind := range v.Kinds {
+		if (kind == "actor" || kind == "usecase") && !seen[name] {
+			t.Fatal("missing", name)
+		}
+	}
+	syntax := s.Diagrams[0].Mermaid()
+	if !strings.HasPrefix(syntax, "usecase-beta") || strings.Contains(syntax, "Feature") || strings.Contains(syntax, "include") || strings.Contains(syntax, "systemBoundary") {
+		t.Fatal(syntax)
+	}
+	context := s.OverviewContext()
+	for _, text := range []string{"Feature | supports | Goal0", "Function | contributes-to | Feature", "not inferred"} {
+		if !strings.Contains(context, text) {
+			t.Fatal(context)
+		}
+	}
+	for _, d := range v.Diagrams {
+		if d.Kind == "usecase" {
+			t.Fatal("overview generated eagerly")
+		}
+	}
+	for _, q := range []Query{{Viewpoint: "VP02", Projection: "overview"}, {Viewpoint: "VP01", Projection: "bad"}, {Viewpoint: "VP01", Projection: "overview", Focus: "Goal0"}, {Viewpoint: "VP01", Projection: "overview", Relations: []string{"pursues"}}, {Viewpoint: "VP01", Projection: "overview", Depth: 1}, {Viewpoint: "VP01", Projection: "overview", Direction: "out"}, {Viewpoint: "VP01", Projection: "overview", Diagram: "VP01-Goal0"}} {
+		if _, e := v.Select(q); e == nil {
+			t.Fatal("ignored overview filter", q)
+		}
+	}
+	q, e := ParseURI("sdl-view://trial/VP01?projection=overview&target=main&consumer=xfmd")
+	if e != nil {
+		t.Fatal(e)
+	}
+	if _, e = v.Select(q.Query); e != nil {
+		t.Fatal(e)
+	}
+	// Existing diagram identity is not captured by the new projection query.
+	existing, e := v.Select(Query{Viewpoint: "VP01", Diagram: "VP01-Goal0"})
+	if e != nil || len(existing.Diagrams) != 1 || existing.Diagrams[0].Kind != "flowchart" {
+		t.Fatal(e)
+	}
+}
+func TestVP01OverviewEmptyAndLimit(t *testing.T) {
+	v, e := New("language design-core version 0.5.\nunit Internal.\n")
+	if e != nil {
+		t.Fatal(e)
+	}
+	s, e := v.Select(Query{Viewpoint: "VP01", Projection: "overview"})
+	if e != nil || len(s.Diagrams) != 0 || len(s.Gaps) == 0 {
+		t.Fatal(e, s)
+	}
+	source := "language design-core version 0.5.\n"
+	for i := 0; i < 129; i++ {
+		source += fmt.Sprintf("usecase Goal%d.\n", i)
+	}
+	v, e = New(canonicalOverview(t, source))
+	if e != nil {
+		t.Fatal(e)
+	}
+	if _, e = v.Select(Query{Viewpoint: "VP01", Projection: "overview"}); e == nil || !strings.Contains(e.Error(), "no partial") {
+		t.Fatal(e)
+	}
+}
+
+func canonicalOverview(t *testing.T, source string) string {
+	t.Helper()
+	m, e := parser.Parse(source)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return parser.FormatFile(m)
+}
+
+func TestOverviewURIRejectsExplicitTraversal(t *testing.T) {
+	if _, e := ParseURI("sdl-view://trial/VP01?projection=overview&depth=0"); e == nil {
+		t.Fatal("explicit depth silently ignored")
+	}
+}
diff --git a/SDL/go/viewpoint/query.go b/SDL/go/viewpoint/query.go
index 0c35ab1..c0e721e 100644
--- a/SDL/go/viewpoint/query.go
+++ b/SDL/go/viewpoint/query.go
@@ -9,14 +9,15 @@ import (
 )
 
 type Query struct {
-	Viewpoint string   `json:"viewpoint"`
-	Focus     string   `json:"focus,omitempty"`
-	Relations []string `json:"relations,omitempty"`
